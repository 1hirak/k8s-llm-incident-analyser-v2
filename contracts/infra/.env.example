# ============================================================================
# Infrastructure Contract — Environment Variables
# ============================================================================
# This file defines EVERY environment variable used by ANY service in the
# platform. Copy to .env and fill in values.
#
# Variables are grouped by service. Service-level variables must match
# the `environment:` keys in docker-compose.yml exactly.
#
# Naming: ALL_CAPS with underscores (standard env var convention).
# This is the ONE exception to the snake_case rule — environment variables
# follow the POSIX convention of uppercase with underscores.
# ============================================================================

# ----------------------------------------------------------------------------
# Gateway Service
# ----------------------------------------------------------------------------
ORCHESTRATOR_URL=http://orchestrator:8001
REPORTS_URL=http://reports:8005
SCENARIO_URL=http://scenario:8006
# Internal URL for llm-svc (for /health provider info)
LLM_URL=http://llm:8004
# Internal URL for collector-svc (for /health cluster status)
COLLECTOR_URL=http://collector:8002
REMEDIATION_URL=http://remediation:8008
RATE_LIMIT_PER_MINUTE=60
GATEWAY_API_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# Orchestrator Service
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
COLLECTOR_URL=http://collector:8002
PROCESSOR_URL=http://processor:8003
LLM_URL=http://llm:8004
# Internal URL for reports-svc (for job archival + report saving).
# Note: this is the same as REPORTS_URL in the gateway — both point to
# the reports service, just from different callers.
REPORTS_URL=http://reports:8005
PIPELINE_TIMEOUT=120

# ----------------------------------------------------------------------------
# Collector Service
# ----------------------------------------------------------------------------
KUBECTL_TIMEOUT=30
KUBECTL_LOG_TAIL=500
KUBERNETES_AUTH_MODE=auto
KUBE_CONTEXT=

# ----------------------------------------------------------------------------
# Processor Service
# ----------------------------------------------------------------------------
MAX_LOG_LINES=100
CONTEXT_WINDOW=3

# ----------------------------------------------------------------------------
# LLM Service
# ----------------------------------------------------------------------------
# Provider selection: mock | openai | anthropic | deepseek | openrouter
LLM_PROVIDER=mock

# Provider API keys (only required for the selected provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Model name override (optional — defaults are provider-specific):
#   openai:    gpt-4o-mini
#   anthropic: claude-haiku-4-5-20251001
#   deepseek:  deepseek-chat
LLM_MODEL=

# Max tokens for LLM response and one truncation retry
LLM_MAX_TOKENS=4096
LLM_RETRY_MAX_TOKENS=8192

# OpenRouter reasoning and cache controls
OPENROUTER_REASONING_EFFORT=
OPENROUTER_PROMPT_CACHE=true
OPENROUTER_RESPONSE_CACHE=false
OPENROUTER_RETRY_DELAY_SECONDS=2

# LLM result cache (Redis is already used by orchestrator)
REDIS_URL=redis://redis:6379/0
LLM_ANALYSIS_CACHE_ENABLED=true
LLM_ANALYSIS_CACHE_TTL=900

# Runtime config file path (Settings page writes keys/model here; the
# file takes precedence over the env vars above). Default: /data/llm-config.json
LLM_CONFIG_PATH=/data/llm-config.json

# ----------------------------------------------------------------------------
# Reports Service
# ----------------------------------------------------------------------------
# SQLite database file path (inside the container)
DATABASE_PATH=/data/reports.db

# ----------------------------------------------------------------------------
# Scenario Service
# ----------------------------------------------------------------------------
K8S_NAMESPACE=demo
SCENARIOS_DIR=/k8s/scenarios
BASE_DIR=/k8s/base

# Watcher service
WATCHER_ENABLED=true
WATCH_NAMESPACES=demo
WATCH_INTERVAL_SECONDS=30
WATCH_COOLDOWN_SECONDS=900
WATCH_RESTART_THRESHOLD=3

# Typed remediation service (approval mode only)
REMEDIATION_ENABLED=false
REMEDIATION_MODE=approval
REMEDIATION_NAMESPACES=demo

# ----------------------------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------------------------
# Client-side API URL (must be reachable from the browser, not Docker network)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=
# Server-side API URL for SSR data fetching (uses Docker network hostname)
INTERNAL_API_URL=http://gateway:8000

# ----------------------------------------------------------------------------
# Cross-cutting (all services)
# ----------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Service version (returned by /health endpoints)
SERVICE_VERSION=0.1.0
