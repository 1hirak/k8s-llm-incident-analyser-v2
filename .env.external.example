# External-cluster deployment for Docker Compose.
# Copy this file to .env.external and replace the placeholders.

# Absolute path on the Docker host to a dedicated kubeconfig. It must point to
# an API endpoint reachable from the container and must not use an admin user.
KUBECONFIG_FILE=/absolute/path/to/analyser-kubeconfig
REMEDIATION_KUBECONFIG_FILE=/absolute/path/to/analyser-kubeconfig.remediation
KUBERNETES_AUTH_MODE=external
KUBE_CONTEXT=

# The watcher and remediation identities are scoped to these namespaces by
# both application policy and Kubernetes RBAC.
WATCHER_ENABLED=true
WATCH_NAMESPACES=production,staging
WATCH_INTERVAL_SECONDS=30
WATCH_COOLDOWN_SECONDS=900
WATCH_RESTART_THRESHOLD=3
REMEDIATION_ENABLED=true
REMEDIATION_MODE=approval
REMEDIATION_NAMESPACES=production,staging

# Public browser/API settings.
NEXT_PUBLIC_API_URL=http://localhost:8000
GATEWAY_API_TOKEN=replace-with-a-long-random-token
NEXT_PUBLIC_API_TOKEN=replace-with-the-same-token-for-the-local-dashboard
CORS_ALLOW_ORIGINS=http://localhost:3000

# LLM configuration. Keep provider secrets in a secret manager where possible.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=
