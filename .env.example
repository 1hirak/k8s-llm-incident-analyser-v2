# ============================================================================
# K8s LLM Incident Analyser — Environment Variables
# ============================================================================
# Copy to .env and fill in values. docker-compose.yml picks these up.
# The authoritative list (grouped by service) is contracts/infra/.env.example.

# ----------------------------------------------------------------------------
# LLM Service (the only service holding external API keys)
# ----------------------------------------------------------------------------
# Provider selection: mock | openai | anthropic | deepseek
LLM_PROVIDER=mock

# Provider API keys (only required for the selected provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Model name override (optional — defaults are provider-specific):
#   openai: gpt-4o-mini · anthropic: claude-haiku-4-5-20251001 · deepseek: deepseek-chat
LLM_MODEL=

# Max tokens for LLM response
LLM_MAX_TOKENS=2000

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
# Client-side gateway URL (inlined at frontend build time; must be
# reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
