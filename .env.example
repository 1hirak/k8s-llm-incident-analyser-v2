# ============================================================================
# K8s LLM Incident Analyser — Environment Variables
# ============================================================================
# Copy to .env and fill in values. docker-compose.yml picks these up.
# The authoritative list (grouped by service) is contracts/infra/.env.example.

# ----------------------------------------------------------------------------
# LLM Service (the only service holding external API keys)
# ----------------------------------------------------------------------------
# Provider selection: mock | openai | anthropic | deepseek | openrouter
LLM_PROVIDER=mock

# Provider API keys (only required for the selected provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Model name override (optional — defaults are provider-specific):
#   openai: gpt-4o-mini · anthropic: claude-haiku-4-5-20251001 · deepseek: deepseek-chat · openrouter: pinned catalog model
LLM_MODEL=

# Max tokens for LLM response and one truncation retry
LLM_MAX_TOKENS=4096
LLM_RETRY_MAX_TOKENS=8192

# OpenRouter reasoning and cache controls
OPENROUTER_REASONING_EFFORT=
OPENROUTER_PROMPT_CACHE=true
OPENROUTER_RESPONSE_CACHE=false
OPENROUTER_RETRY_DELAY_SECONDS=2

# LLM result cache (Redis is already used by orchestrator)
REDIS_URL=redis://redis:6379/0
LLM_ANALYSIS_CACHE_ENABLED=true
LLM_ANALYSIS_CACHE_TTL=900

# Runtime config file path (Settings page writes keys/model here; the
# file takes precedence over the env vars above). Default: /data/llm-config.json
# LLM_CONFIG_PATH=/data/llm-config.json

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
# Client-side gateway URL (inlined at frontend build time; must be
# reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=

# ----------------------------------------------------------------------------
# Kubernetes connection, watcher, and approved remediation
# ----------------------------------------------------------------------------
# The local Minikube helper creates .runtime/kubeconfig automatically. For an
# external cluster use .env.external.example and mount a dedicated kubeconfig.
KUBERNETES_AUTH_MODE=auto
KUBE_CONTEXT=
WATCHER_ENABLED=true
WATCH_NAMESPACES=demo
WATCH_INTERVAL_SECONDS=30
WATCH_COOLDOWN_SECONDS=900
WATCH_RESTART_THRESHOLD=3
REMEDIATION_ENABLED=false
REMEDIATION_MODE=approval
REMEDIATION_NAMESPACES=demo

# Set this in a protected deployment. The empty value keeps local development
# compatible; production gateways must require a Bearer token.
GATEWAY_API_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3000
